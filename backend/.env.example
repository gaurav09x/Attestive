# --- Environment ---------------------------------------------------------
ENVIRONMENT=development
DEBUG=false

# --- Security ------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=insecure-development-key-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_SECURE=false
# lax = frontend and API share an origin; none = different origins (needs COOKIE_SECURE=true)
COOKIE_SAMESITE=lax

# --- Database ------------------------------------------------------------
# Local, no-Docker fallback (default):
DATABASE_URL=sqlite+aiosqlite:///./data/attestive.db
# PostgreSQL via docker compose:
# DATABASE_URL=postgresql+asyncpg://attestive:attestive@localhost:5432/attestive

# --- Frontend / CORS -----------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173
# Used for links in verification and password-reset emails.
APP_BASE_URL=http://localhost:5173

# --- Account protection --------------------------------------------------
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- Email delivery ------------------------------------------------------
# console  = log the message (development only; body suppressed outside development)
# disabled = create no delivery
# resend | sendgrid = HTTPS API, needs EMAIL_API_KEY
# smtp     = any SMTP host (SES, Mailgun, Gmail app password), needs SMTP_* below
EMAIL_DELIVERY=console
# Must be a verified sender/domain at your provider.
EMAIL_FROM=Attestive <no-reply@localhost>
EMAIL_API_KEY=
EMAIL_TIMEOUT_SECONDS=10
# SMTP settings (only used when EMAIL_DELIVERY=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
VERIFY_TOKEN_TTL_HOURS=48
RESET_TOKEN_TTL_MINUTES=60

# --- Rate limiting (per process) -----------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_DEFAULT_PER_MINUTE=120

# --- AI (Phase 3+) -------------------------------------------------------
# ollama = local model server; openai = any OpenAI-compatible hosted API
# (Z.ai, OpenAI, Groq, Together, vLLM); disabled = deterministic only.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text
# Tutor replies need longer than the roadmap note; raise this on slow CPU-only hosts.
OLLAMA_TIMEOUT_SECONDS=120

# Hosted provider (AI_PROVIDER=openai). Keep the key server-side.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_TIMEOUT_SECONDS=60
# Roadmap plan notes fall back to a deterministic rationale when unavailable.
AI_ROADMAP_ENABLED=true
ROADMAP_AI_TIMEOUT_SECONDS=12
